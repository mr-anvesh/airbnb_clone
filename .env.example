# Your Docker Hub username (used for image names)
DOCKER_USERNAME=yourusername

# Port the app will be accessible on the server (default: 80)
HOST_PORT=80

# PostgreSQL connection string. SQLAlchemy uses the psycopg driver.
DATABASE_URL=postgresql+psycopg://airbnb:airbnb@localhost:5432/airbnb

# Infrastructure endpoints for local development.
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# JWT Secret Key for token signing (replace with a random 32+ character string in production)
SECRET_KEY=change-this-to-a-random-32-char-string
